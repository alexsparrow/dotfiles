#!/usr/bin/env bash
PDIR="$HOME/.config/claude-profiles"
STATE="$PDIR/.current"
cur=$(cat "$STATE" 2>/dev/null || echo default)

list_profiles() {
  echo default
  for d in "$PDIR"/*/; do [ -d "$d" ] && basename "$d"; done 2>/dev/null
}

case "$1" in
  "")
    for n in $(list_profiles); do
      [ "$cur" = "$n" ] && echo "* $n" || echo "  $n"
    done ;;
  --dir)
    [ "$cur" = default ] && echo "$HOME/.config/claude" || echo "$PDIR/$cur" ;;
  --complete)
    list_profiles ;;
  *)
    if [ "$1" = default ]; then
      rm -f "$STATE"
    elif [ -d "$PDIR/$1" ]; then
      mkdir -p "$(dirname "$STATE")"
      echo "$1" > "$STATE"
    else
      echo "Unknown profile: $1 (create with: mkdir -p $PDIR/$1)" >&2
      exit 1
    fi
    echo "Switched to '$1'. Restart shell to apply." ;;
esac
