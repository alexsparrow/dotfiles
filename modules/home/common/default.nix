{ inputs, pkgs, ... }:
{
  imports = [
    inputs.ratune.homeManagerModules.default
    ./direnv.nix
    ./emacs.nix
    ./git.nix
    ./ghostty.nix
    ./vscode.nix
    ./zsh.nix
  ];

  home.sessionVariables.EDITOR = "vim";

  programs.ratune.enable = true;

  xdg.configFile."ratune/config.toml" = {
    source = ./ratune/config.toml;
    # Replace the default config generated by ratune on first launch.
    force = true;
  };

  home.username = "alex";
  home.homeDirectory = if pkgs.stdenv.hostPlatform.isDarwin then "/Users/alex" else "/home/alex";

  # Tools I want on every machine, whatever the platform.
  home.packages = with pkgs; [
    bitwarden-desktop
    claude-code
    devenv # per-project toolchains; keeps this list to the machine-wide stuff
    docker-compose
    glow
    htop
    kubectl
    llm
    nixfmt
    nmap
    postgresql
    ripgrep
    zip
  ];

  home.file.".bin" = {
    source = ../../../bin;
    recursive = true;
  };

  # Let Home Manager install and manage itself.
  programs.home-manager.enable = true;
}
